{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Surtr",
  "scopeName": "source.surtr",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#attributes" },
    { "include": "#type-use" },
    { "include": "#keywords" },
    { "include": "#builtin-types" },
    { "include": "#nameable-composite-types" },
    { "include": "#language-variables" },
    { "include": "#property-type" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#function-call" },
    { "include": "#variable-use" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#doc-comment" },
        { "include": "#line-comment" },
        { "include": "#block-comment" }
      ]
    },
    "doc-comment": {
      "begin": "///(?!/)",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.surtr" } },
      "end": "$",
      "name": "comment.block.documentation.surtr",
      "patterns": [
        { "match": "@[A-Za-z_][A-Za-z0-9_]*", "name": "keyword.other.documentation.surtr" }
      ]
    },
    "line-comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.surtr"
    },
    "block-comment": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.surtr"
    },
    "strings": {
      "patterns": [
        { "include": "#string" },
        { "include": "#character" }
      ]
    },
    "string": {
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.surtr" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.surtr" } },
      "name": "string.quoted.double.surtr",
      "patterns": [
        { "include": "#escaped-char" },
        { "include": "#interpolation" },
        { "include": "#simple-interpolation" }
      ]
    },
    "character": {
      "begin": "'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.surtr" } },
      "end": "'",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.surtr" } },
      "name": "string.quoted.single.surtr",
      "patterns": [
        { "include": "#escaped-char" }
      ]
    },
    "escaped-char": {
      "match": "\\\\(?:[nrt0'\"\\\\$u]|u[0-9A-Fa-f]{4})",
      "name": "constant.character.escape.surtr"
    },
    "interpolation": {
      "begin": "\\$\\{",
      "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.surtr" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.surtr" } },
      "name": "meta.template-expression.surtr",
      "patterns": [
        { "include": "#string" },
        { "include": "#character" },
        { "include": "#comments" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#type-use" },
        { "include": "#builtin-types" },
        { "include": "#nameable-composite-types" },
        { "include": "#language-variables" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#function-call" },
        { "include": "#variable-use" }
      ]
    },
    "simple-interpolation": {
      "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
      "name": "meta.template-expression.surtr",
      "captures": {
        "1": { "name": "punctuation.definition.template-expression.begin.surtr" },
        "2": { "name": "variable.other.surtr" }
      }
    },
    "numbers": {
      "patterns": [
        { "match": "\\b0[xX][0-9a-fA-F_]+", "name": "constant.numeric.integer.surtr" },
        { "match": "\\b0[bB][01_]+", "name": "constant.numeric.integer.surtr" },
        { "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?", "name": "constant.numeric.float.surtr" },
        { "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*", "name": "constant.numeric.float.surtr" },
        { "match": "\\b[0-9][0-9_]*", "name": "constant.numeric.integer.surtr" }
      ]
    },
    "declarations": {
      "patterns": [
        { "include": "#import-declaration" },
        { "include": "#alias-declaration" },
        { "include": "#type-declaration" },
        { "include": "#extension-declaration" },
        { "include": "#function-declaration" },
        { "include": "#constructor-declaration" },
        { "include": "#variable-declaration" },
        { "include": "#const-declaration" },
        { "include": "#operator-declaration" },
        { "include": "#property-declaration" },
        { "include": "#catch-param" }
      ]
    },
    "variance-modifier": {
      "comment": "out/in are variance modifiers (§6) only where a type parameter list can have them: immediately before the parameter's own identifier. This rule is included ONLY inside declaration headers (type-declaration, function-declaration) - the one region where a <T, ...> list lives - so an ordinary 'in' in a for-in or an identifier named out elsewhere never matches: after the modifier word must come another identifier (the parameter name), which is never the shape of for-in ('in items)') or of a type reference. `in` is reserved anyway; `out` is contextual and this is its one keyword position.",
      "match": "\\b(?:out|in)\\b(?=\\s*[A-Za-z_][A-Za-z0-9_]*)",
      "name": "storage.modifier.surtr"
    },
    "import-declaration": {
      "comment": "The terminator is optional (§1): an import ends at a ';', at a line break, or at the end of the file. An explicit ';' still matches (and is captured) so both styles highlight the same.",
      "match": "(\\bimport\\b)(\\s+)([A-Za-z_][A-Za-z0-9_.]*\\*?)(;)?",
      "captures": {
        "1": { "name": "keyword.control.import.surtr" },
        "3": { "name": "support.module.surtr" },
        "4": { "name": "punctuation.terminator.statement.surtr" }
      }
    },
    "alias-declaration": {
      "match": "(\\balias\\b)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.alias.surtr" },
        "3": { "name": "entity.name.type.surtr" }
      }
    },
    "type-declaration": {
      "begin": "(\\b(?:class|interface|enum|singleton)\\b)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.type.surtr" },
        "3": { "name": "entity.name.type.surtr" }
      },
      "end": "(?=[{;])",
      "name": "meta.type.declaration.surtr",
      "patterns": [
        { "include": "#variance-modifier" },
        { "include": "#type-reference" },
        { "include": "#comments" },
        { "include": "#punctuation" }
      ]
    },
    "extension-declaration": {
      "comment": "extension <Type> { ... } (§15) adds members to a type already declared elsewhere, without editing it - the target names an *existing* type rather than declaring a new one, so it is colored support.type.surtr like any other type reference, not entity.name.type.surtr the way type-declaration's own name is. An optional extension<T : Bound> ... list (§15.4) only needs writing out for a constraint; a bare type parameter used inside the target (extension T[] { }, extension Box<T> { }) is enough on its own and is highlighted by type-reference like any other identifier there.",
      "begin": "\\bextension\\b",
      "beginCaptures": {
        "0": { "name": "keyword.declaration.type.surtr" }
      },
      "end": "(?=\\{)",
      "name": "meta.extension.declaration.surtr",
      "patterns": [
        { "include": "#builtin-types" },
        { "include": "#type-reference" },
        { "include": "#comments" },
        { "include": "#punctuation" }
      ]
    },
    "function-declaration": {
      "comment": "fun and generator share one rule (§3.7): generator is an introducer standing exactly where fun would — like constructor and operator, it says what kind of member this is, not a modifier — so its parameters and declared element type deserve the same signature context they get for fun.",
      "begin": "(\\b(?:fun|generator)\\b)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.function.surtr" },
        "3": { "name": "entity.name.function.surtr" }
      },
      "end": "(?=[{};])",
      "name": "meta.function.signature.surtr",
      "patterns": [
        { "include": "#variance-modifier" },
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#type-annotation" },
        { "include": "#return-type" },
        { "include": "#builtin-types" },
        { "include": "#operators" },
        { "include": "#language-variables" },
        { "include": "#function-call" },
        { "include": "#variable-use" },
        { "include": "#punctuation" }
      ]
    },
    "constructor-declaration": {
      "begin": "(\\bconstructor\\b)",
      "beginCaptures": {
        "0": { "name": "keyword.declaration.function.surtr" }
      },
      "end": "(?=[{};])",
      "name": "meta.function.signature.surtr",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#type-annotation" },
        { "include": "#return-type" },
        { "include": "#builtin-types" },
        { "include": "#operators" },
        { "include": "#language-variables" },
        { "include": "#function-call" },
        { "include": "#variable-use" },
        { "include": "#punctuation" }
      ]
    },
    "variable-declaration": {
      "match": "(\\b(?:let|var)\\b)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s*:\\s*)?((?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?)?",
      "captures": {
        "1": { "name": "storage.type.variable.surtr" },
        "3": { "name": "variable.other.readwrite.surtr" },
        "4": { "name": "punctuation.separator.colon.surtr" },
        "5": { "name": "support.type.surtr" }
      }
    },
    "const-declaration": {
      "match": "(\\bconst\\b)(\\s+)(?!fun\\b|if\\b|class\\b|interface\\b|enum\\b|singleton\\b|operator\\b)([A-Za-z_][A-Za-z0-9_]*)(\\s*:\\s*)?((?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?)?",
      "captures": {
        "1": { "name": "keyword.declaration.constant.surtr" },
        "3": { "name": "variable.other.constant.surtr" },
        "4": { "name": "punctuation.separator.colon.surtr" },
        "5": { "name": "support.type.surtr" }
      }
    },
    "operator-declaration": {
      "begin": "\\boperator\\b(\\s*)(>>>=|<=>|===|!==|>>>|>>=|<<=|<<|>>|\\[\\]|==|!=|\\+\\+|--|as\\b|[-+*/%&|^~!<>])",
      "beginCaptures": {
        "0": { "name": "keyword.declaration.function.surtr" },
        "2": { "name": "entity.name.function.operator.surtr" }
      },
      "end": "(?=[{};])",
      "name": "meta.function.signature.surtr",
      "patterns": [
        { "include": "#type-before-paren" },
        { "include": "#type-annotation" },
        { "include": "#return-type" },
        { "include": "#builtin-types" },
        { "include": "#strings" },
        { "include": "#comments" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#language-variables" },
        { "include": "#function-call" },
        { "include": "#variable-use" },
        { "include": "#punctuation" }
      ]
    },
    "property-declaration": {
      "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*:\\s*(?:[^;={}()]|\\([^)]*\\)\\s*->|\\{[^}]*\\})+\\s*\\{)",
      "name": "entity.name.variable.property.surtr"
    },
    "catch-param": {
      "match": "(\\bcatch\\b)(\\s*)(\\()([A-Za-z_][A-Za-z0-9_]*)(\\s*:\\s*)((?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?)(\\))",
      "captures": {
        "1": { "name": "keyword.control.exception.surtr" },
        "3": { "name": "punctuation.section.group.surtr" },
        "4": { "name": "variable.parameter.surtr" },
        "6": { "name": "support.type.surtr" },
        "7": { "name": "punctuation.section.group.surtr" }
      }
    },
    "type-reference": {
      "match": "(?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?",
      "name": "support.type.surtr"
    },
    "type-annotation": {
      "match": "([A-Za-z_][A-Za-z0-9_]*)(\\s*:\\s*)((?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?)((\\s*)(&)(\\s*)((?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?))?",
      "captures": {
        "1": { "name": "variable.parameter.surtr" },
        "3": { "name": "support.type.surtr" },
        "6": { "name": "keyword.operator.surtr" },
        "8": { "name": "support.type.surtr" }
      }
    },
    "return-type": {
      "match": "(\\s*)(:)(\\s*)((?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?)(?=\\s*[{;=]|$)",
      "captures": {
        "2": { "name": "punctuation.separator.colon.surtr" },
        "4": { "name": "support.type.surtr" }
      }
    },
    "type-before-paren": {
      "match": "(?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?=\\s*\\()",
      "name": "support.type.surtr"
    },
    "property-type": {
      "match": "(?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?(?=\\s*\\{)",
      "name": "support.type.surtr"
    },
    "type-use": {
      "patterns": [
        {
          "match": "(\\bas\\?(?!\\w))(\\s*)((?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?)",
          "captures": {
            "1": { "name": "keyword.operator.cast.safe.surtr" },
            "3": { "name": "support.type.surtr" }
          }
        },
        {
          "match": "(\\bas\\b)(\\s*)((?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?)",
          "captures": {
            "1": { "name": "keyword.operator.cast.surtr" },
            "3": { "name": "support.type.surtr" }
          }
        },
        {
          "match": "(\\bis\\b)(\\s*)((?!(?:int|float|bool|char|string|bytes|void|range|unknown)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^<>]*(?:<[^<>]*>[^<>]*)*>)?(?:\\s*\\[\\s*\\])?(?:\\s*\\?)?)",
          "captures": {
            "1": { "name": "keyword.operator.expression.surtr" },
            "3": { "name": "support.type.surtr" }
          }
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
          "name": "meta.annotation.surtr",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.surtr" },
            "2": { "name": "entity.name.function.annotation.surtr" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(?:true|false)\\b", "name": "constant.language.boolean.surtr" },
        { "match": "\\bnull\\b", "name": "constant.language.null.surtr" },
        { "match": "\\bas\\?(?!\\w)", "name": "keyword.operator.cast.safe.surtr" },
        { "match": "\\bas\\b", "name": "keyword.operator.cast.surtr" },
        { "match": "\\bis\\b", "name": "keyword.operator.expression.surtr" },
        { "match": "\\b(?:typeof|moduleof)\\b", "name": "keyword.operator.expression.surtr" },
        { "match": "\\b(?:if|else|for|while|switch|case|default|break|continue|return|in|using)\\b", "name": "keyword.control.surtr" },
        {
          "comment": "each is contextual (§5.x), recognized only as the collection-builder clause of a constructor: 'each (' followed by a parameter list ('name: type'). Demanding the 'name:' shape keeps a call to something literally named each (each(x)) from matching. semanticTokens is the robust fix for full position-accuracy; this is the regex-only approximation.",
          "match": "\\b(each)\\s*\\(\\s*[A-Za-z_][A-Za-z0-9_]*\\s*:",
          "captures": {
            "1": { "name": "keyword.declaration.function.surtr" }
          }
        },
        {
          "comment": "yield opens an expression at the lowest precedence there is (§3.7), and 'from' is contextual: recognized only directly after 'yield', an ordinary identifier everywhere else — the spec's own example writes countdown(from: int). Matching 'yield from' as one unit delivers that position rule without lookbehind; 'yield (from)', parens included, leaves 'from' to the variable rule like any identifier.",
          "match": "\\b(yield)(?:\\s+(from)\\b)?",
          "captures": {
            "1": { "name": "keyword.control.surtr" },
            "2": { "name": "keyword.control.surtr" }
          }
        },
        { "match": "\\b(?:try|catch|finally|throw)\\b", "name": "keyword.control.exception.surtr" },
        { "match": "\\b(?:abstract|public|private|protected|internal|static|sealed|virtual|override)\\b", "name": "storage.modifier.surtr" },
        { "match": "\\b(?:inline|forceinline|noinline)\\b", "name": "keyword.declaration.inline.surtr" },
        { "match": "\\bnative\\b", "name": "keyword.declaration.native.surtr" },
        { "match": "\\bconst\\b", "name": "keyword.declaration.constant.surtr" },
        { "match": "\\bfun\\b", "name": "keyword.declaration.function.surtr" },
        {
          "comment": "generator is hard-reserved (§3.7) and the one reserved word that also appears in type position, since generator<T> is what a call to a generator function produces. The lookahead form colors that type use like array/dict/tuple below; the bare form colors the member introducer standing where fun would. The two never overlap: a declaration's next token is always its name, a type use's is always '<'.",
          "match": "\\bgenerator\\b(?=\\s*<)",
          "name": "support.type.surtr"
        },
        { "match": "\\bgenerator\\b", "name": "keyword.declaration.function.surtr" },
        { "match": "\\bconstructor\\b", "name": "keyword.declaration.function.surtr" },
        { "match": "\\boperator\\b", "name": "keyword.declaration.function.surtr" },
        { "match": "\\b(?:class|interface|enum|singleton)\\b", "name": "keyword.declaration.type.surtr" },
        { "match": "\\bextension\\b", "name": "keyword.declaration.type.surtr" },
        { "match": "\\balias\\b", "name": "keyword.declaration.alias.surtr" },
        { "match": "\\b(?:let|var)\\b", "name": "storage.type.variable.surtr" },
        { "match": "\\bvalue(?=\\s+class\\b)", "name": "keyword.declaration.type.surtr" },
        {
          "comment": "attribute is contextual (§1.2), recognized only immediately before the 'class' that makes it an attribute class declaration (§11) - with or without a parenthesized target/retention list (attribute(Method, Property) class X). Anywhere else the word is an ordinary identifier, same as 'value' above.",
          "match": "\\battribute\\b(?=\\s*(?:\\([^()]*\\))?\\s*class\\b)",
          "name": "keyword.declaration.type.surtr"
        },
        { "match": "\\bimport\\b", "name": "keyword.control.import.surtr" },
        {
          "comment": "export marks re-exports (§2.1: `export import X.Y;` hands X.Y's surface out as this module's own). Reserved since before the generators wave but never colored here.",
          "match": "\\bexport\\b",
          "name": "keyword.control.import.surtr"
        },
        {
          "comment": "get/set are not reserved at all - the parser recognizes them purely by position inside a property's accessor list (§3.4). A regex grammar cannot see that position the way the real parser does, so this only fires for the accessor shapes that can never be a call: 'get'/'set' immediately followed by '=>', '{' or a bare ';' - a call like dict.get(k) always has '(' right after and never matches. The narrow false positive this still admits is a variable literally named get/set read bare before a ';' (e.g. 'return get;'); textDocument/semanticTokens is the robust fix for full position-accuracy, this is the regex-only approximation.",
          "match": "\\b(?:get|set)\\b(?=\\s*(?:=>|\\{|;))",
          "name": "keyword.other.accessor.surtr"
        }
      ]
    },
    "builtin-types": {
      "match": "\\b(?:int|float|bool|char|string|bytes|void|range|unknown)\\b",
      "name": "storage.type.primitive.surtr"
    },
    "nameable-composite-types": {
      "comment": "array<T>, dict<K,V> and tuple<...> name the same types T[], {K:V} and (T1,...,Tn) already do, but only these three have an identifier form at all, which is what lets a constructor be called on them (there's no `new`). Recognized only when followed by '<' so a variable that happens to be named array/dict/tuple still highlights as an ordinary identifier.",
      "match": "\\b(?:array|dict|tuple)\\b(?=\\s*<)",
      "name": "support.type.surtr"
    },
    "language-variables": {
      "match": "\\b(?:this|super)\\b",
      "name": "variable.language.surtr"
    },
    "operators": {
      "patterns": [
        { "match": "\\.\\.\\.", "name": "keyword.operator.varargs.surtr" },
        { "match": ">>>=|>>=|<<=|>>>|<<|>>", "name": "keyword.operator.arithmetic.surtr" },
        { "match": "<=>|===|!==|==|!=|<=|>=", "name": "keyword.operator.comparison.surtr" },
        { "match": "&&|\\|\\|", "name": "keyword.operator.logical.surtr" },
        { "match": "\\?\\?=|\\?\\?|\\?\\.|!!", "name": "keyword.operator.other.surtr" },
        { "match": "\\.\\.=|\\.\\.", "name": "keyword.operator.other.surtr" },
        { "match": "=>|->", "name": "keyword.operator.arrow.surtr" },
        { "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|\\+\\+|--", "name": "keyword.operator.assignment.surtr" },
        { "match": "=", "name": "keyword.operator.assignment.surtr" },
        { "match": "[-+*/%&|^~!<>?]", "name": "keyword.operator.surtr" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": "[{}]", "name": "punctuation.section.block.surtr" },
        { "match": "[\\(\\)]", "name": "punctuation.section.group.surtr" },
        { "match": "[\\[\\]]", "name": "punctuation.section.brackets.surtr" },
        { "match": ";", "name": "punctuation.terminator.statement.surtr" },
        { "match": ",", "name": "punctuation.separator.comma.surtr" },
        { "match": "\\.", "name": "punctuation.accessor.dot.surtr" },
        { "match": ":", "name": "punctuation.separator.colon.surtr" },
        { "match": "@", "name": "punctuation.definition.annotation.surtr" }
      ]
    },
    "function-call": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()",
      "name": "support.function.surtr"
    },
    "variable-use": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.surtr"
    }
  }
}
