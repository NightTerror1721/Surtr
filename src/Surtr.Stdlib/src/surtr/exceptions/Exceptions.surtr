// Exceptions.surtr
//
// The exception hierarchy below the root. `Exception` itself stays in C# (SurtrStandardLibrary):
// it owns the `_message` slot and the native `message` getter / `toString` / constructor, which
// the runtime's raise helpers reach through the fixed MessageSlot. Each subclass here is a
// constructor and nothing else -- what distinguishes IndexOutOfRangeException from
// KeyNotFoundException is the class a `catch` names, and nothing is inherited from one.
//
// These are the first Surtr classes the compiler is asked to compile that extend a built-in
// C# type, which is exactly the "largest program the compiler has never been asked to compile"
// that docs/Compiler-Plan.md §10.2 names as the one thing still owed.

public class ArgumentException : Exception {
    public constructor(message: string) : super(message) { }
}

public class FormatException : Exception {
    public constructor(message: string) : super(message) { }
}

public class IndexOutOfRangeException : Exception {
    public constructor(message: string) : super(message) { }
}

public class KeyNotFoundException : Exception {
    public constructor(message: string) : super(message) { }
}

public class NullReferenceException : Exception {
    public constructor(message: string) : super(message) { }
}

public class DivideByZeroException : Exception {
    public constructor(message: string) : super(message) { }
}

public class InvalidCastException : Exception {
    public constructor(message: string) : super(message) { }
}

public class StackOverflowException : Exception {
    public constructor(message: string) : super(message) { }
}

public class InvalidOperationException : Exception {
    public constructor(message: string) : super(message) { }
}
