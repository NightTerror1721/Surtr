import surtr.core.Exception;

public interface IReadOnlyCollection<T> : IIterable<T>
{
    length: int { get; }

    fun contains(item: T): bool;
    fun copyTo(array: T[], arrayIndex: int): void;
}

public interface ICollection<T> : IReadOnlyCollection<T>
{
    isReadOnly: bool { get; }

    fun add(item: T): void;
    fun remove(item: T): bool;
    fun clear(): void;
}

private value class ReadOnlyCollection<T> : IReadOnlyCollection<T>
{
    private let _col: IReadOnlyCollection<T>;

    public constructor(collection: IReadOnlyCollection<T>)
    {
        this._col = collection;
    }

    public constructor(collection: ICollection<T>)
    {
        this._col = collection;
    }

    public length: int { get { return this._col.length; } }

    public fun contains(item: T): bool
    {
        return _col.contains(item);
    }

    public fun copyTo(array: T[], arrayIndex: int): void
    {
        _col.copyTo(array, arrayIndex);
    }

    public fun iterate(): IIterator<T>
    {
        return _col.iterate();
    }
}
