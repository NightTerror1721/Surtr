public interface IReadOnlyCollection<T> : IIterable<T>
{
    length: int { get; }

    fun contains(item: T): bool;
    fun copyTo(array: T[], arrayIndex: int): void;
}

public interface ICollection<T> : IReadOnlyCollection<T>
{
    isReadOnly: bool { get; }

    fun add(item: T): void;
    fun remove(item: T): bool;
    fun clear(): void;
}

// A thin read-only view over another collection - wraps rather than copies, so it stays live if the
// wrapped collection changes. `List<T>.asReadOnly()`/`Set<T>.asReadOnly()` are what construct one;
// nothing outside this file needs to name the type itself, only the `IReadOnlyCollection<T>` it
// returns as. One constructor only, deliberately: `ICollection<T>` already extends
// `IReadOnlyCollection<T>`, so a second overload typed by it would be redundant and every caller
// (a `List<T>`/`Set<T>`) satisfies the one constructor already declared.
public value class ReadOnlyCollection<T> : IReadOnlyCollection<T>
{
    private let _col: IReadOnlyCollection<T>;

    public constructor(collection: IReadOnlyCollection<T>)
    {
        this._col = collection;
    }

    public length: int { get { return this._col.length; } }

    public fun contains(item: T): bool
    {
        return _col.contains(item);
    }

    public fun copyTo(array: T[], arrayIndex: int): void
    {
        _col.copyTo(array, arrayIndex);
    }

    public fun iterate(): IIterator<T>
    {
        return _col.iterate();
    }
}
