import surtr.collections.List;

extension IIterable<T>
{
    fun toArray(self: IIterable<T>): T[]
    {
        var result: T[] = [];
        let it = self.iterate();
        while (it.moveNext())
            result.push(it.current);

        return result;
    }
}


fun test(): void
{
    let list = List<int>();
    let arr = list.toArray();
}
