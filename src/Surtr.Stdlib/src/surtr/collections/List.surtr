import surtr.collections.Collection;

public interface IReadOnlyList<T> default List<T> : IReadOnlyCollection<T>
{
    fun get(index: int): T;
    fun indexOf(item: T): int;
}

public interface IList<T> default List<T> : IReadOnlyList<T>, ICollection<T>
{
    fun set(index: int, value: T): void;
    fun insert(index: int, item: T): void;
    fun removeAt(index: int): bool;
}

public class List<T> : IList<T>
{
    private const DefaultCapacity: int = 4;

    private var _items: T[];
    private var _length: int;
    private var _capacity: int;

    public constructor(initialCapacity: int = DefaultCapacity)
    {
        if (initialCapacity < 0) throw IndexOutOfRangeException("Initial capacity must be non-negative");
        this._capacity = initialCapacity;
        this._items = array<T>(_capacity);
        this._length = 0;
    }

    // §5.x: the collection-builder form — `List<int>[1, 2, 3]` builds the empty list through this
    // constructor, then fills it one element per call to the $fill$ method below.
    public constructor(capacity: int = DefaultCapacity) : this(capacity)
    {
    }
    each (item: T)
    {
        if (_length == _capacity) ensureCapacity(_length + 1);
        _items[_length] = item;
        _length++;
    }

    public inline length: int => _length;
    public inline isReadOnly: bool => false;

    public fun get(index: int): T
    {
        if (index < 0 || index >= _length) throw IndexOutOfRangeException("Index out of range");
        return _items[index];
    }

    public fun set(index: int, value: T): void
    {
        if (index < 0 || index >= _length) throw IndexOutOfRangeException("Index out of range");
        _items[index] = value;
    }

    public fun add(item: T): void
    {
        if (_length == _capacity) ensureCapacity(_length + 1);
        _items[_length] = item;
        _length++;
    }

    public fun insert(index: int, item: T): void
    {
        if (index < 0 || index > _length) throw IndexOutOfRangeException("Index out of range");
        if (_length == _capacity) ensureCapacity(_length + 1);
        for (var i = _length; i > index; i--)
            _items[i] = _items[i - 1];
        _items[index] = item;
        _length++;
    }

    public fun removeAt(index: int): bool
    {
        if (index < 0 || index >= _length) throw IndexOutOfRangeException("Index out of range");
        for (var i = index; i < _length - 1; i++)
            _items[i] = _items[i + 1];
        _length--;
        return true;
    }

    public fun remove(item: T): bool
    {
        var index = this.indexOf(item);
        if (index >= 0)
        {
            this.removeAt(index);
            return true;
        }
        return false;
    }

    public inline fun clear(): void
    {
        _length = 0;
    }

    public fun indexOf(item: T): int
    {
        for (var i = 0; i < _length; i++)
        {
            if (_items[i] == item) return i;
        }
        return -1;
    }

    public inline fun contains(item: T): bool
    {
        return this.indexOf(item) >= 0;
    }

    public fun copyTo(array: T[], arrayIndex: int): void
    {
        if (arrayIndex < 0) throw IndexOutOfRangeException("Array index must be non-negative");
        if (array.length - arrayIndex < _length) throw ArgumentException("The number of elements in the source List is greater than the available space from arrayIndex to the end of the destination array.");
        for (var i = 0; i < _length; i++)
            array[arrayIndex + i] = _items[i];
    }

    public inline fun iterate(): IIterator<T>
    {
        return Iterator<T>(_items, _length);
    }

    inline operator [](self: List<T>, index: int): T { return self.get(index); }
    inline operator [](self: List<T>, index: int, value: T): void { self.set(index, value); }

    private fun ensureCapacity(min: int): void
    {
        if (_capacity < min)
        {
            var newCapacity = _capacity == 0 ? DefaultCapacity : _capacity * 2;
            if (newCapacity < min) newCapacity = min;
            var newItems = array<T>(newCapacity);
            for (var i = 0; i < _length; i++)
                newItems[i] = _items[i];
            _items = newItems;
            _capacity = newCapacity;
        }
    }

    private sealed class Iterator<T> : IIterator<T>
    {
        private let _items: T[];
        private let _length: int;
        private var _index: int;

        public constructor(items: T[], length: int, index: int = -1)
        {
            this._items = items;
            this._length = length;
            this._index = index;
        }

        public current: T
        {
            get
            {
                if (_index < 0 || _index >= _length) throw IndexOutOfRangeException("Iterator is out of bounds");
                return _items[_index];
            }
        }

        // Nothing held that outlives this cursor, so the contract slot is filled and empty.
        public fun dispose(): void { }

        public fun moveNext(): bool
        {
            if (_index + 1 < _length)
            {
                _index++;
                return true;
            }
            return false;
        }
    }
}


public class LinkedList<T> : IList<T>
{
    private sealed class Node<T>
    {
        public var value: T;
        public var next: Node<T>? = null;
        public var prev: Node<T>? = null;

        public constructor(value: T)
        {
            this.value = value;
        }
    }

    private sealed class Iterator<T> : IIterator<T>
    {
        private var _node: Node<T>?;
        private var _current: T;

        public constructor(node: Node<T>?)
        {
            this._node = node;
        }

        // Nothing held that outlives this cursor, so the contract slot is filled and empty.
        public fun dispose(): void { }

        public fun moveNext(): bool
        {
            if (this._node === null) return false;
            this._current = this._node.value;
            this._node = this._node.next;
            return true;
        }

        public current: T
        {
            get { return this._current; }
        }
    }

    private var _head: Node<T>?;
    private var _tail: Node<T>?;
    private var _length: int;

    public constructor()
    {
        this._head = null;
        this._tail = null;
        this._length = 0;
    }

    // §5.x: the collection-builder form — `LinkedList<int>[1, 2, 3]` fills through this $fill$ method.
    public constructor() : this()
    {
    }
    each (item: T)
    {
        add(item);
    }

    public length: int => _length;

    public isReadOnly: bool => false;

    public front: T
    {
        get
        {
            if (this._head === null) throw IndexOutOfRangeException("LinkedList is empty");
            return this._head.value;
        }
    }

    public back: T
    {
        get
        {
            if (this._tail === null) throw IndexOutOfRangeException("LinkedList is empty");
            return this._tail.value;
        }
    }

    public fun add(value: T): void
    {
        var newNode = Node<T>(value);
        if (_tail === null)
        {
            _head = newNode;
            _tail = newNode;
        }
        else
        {
            _tail.next = newNode;
            newNode.prev = _tail;
            _tail = newNode;
        }
        _length++;
    }

    public fun insert(index: int, value: T): void
    {
        if (index < 0 || index > this._length) throw IndexOutOfRangeException("Index out of range");
        var newNode = Node<T>(value);
        if (index == 0)
        {
            newNode.next = _head;
            if (_head !== null) _head.prev = newNode;
            _head = newNode;
            if (_tail === null) _tail = newNode;
        }
        else if (index == this._length)
        {
            this.add(value);
            return;
        }
        else
        {
            var current = _head;
            for (var i = 0; i < index; i++)
                current = current!!.next;

            newNode.next = current;
            newNode.prev = current!!.prev;
            if (current.prev !== null) current.prev!!.next = newNode;
            current.prev = newNode;
        }
        _length++;
    }

    public fun get(index: int): T
    {
        if (index < 0 || index >= this._length) throw IndexOutOfRangeException("Index out of range");
        var current = _head;
        for (var i = 0; i < index; i++)
            current = current.next!!;
        return current.value;
    }

    public fun set(index: int, value: T): void
    {
        if (index < 0 || index >= this._length) throw IndexOutOfRangeException("Index out of range");
        var current = _head;
        for (var i = 0; i < index; i++)
            current = current.next!!;
        current.value = value;
    }

    public fun contains(item: T): bool
    {
        var current = _head;
        while (current !== null)
        {
            if (current.value == item) return true;
            current = current.next;
        }
        return false;
    }

    public fun copyTo(array: T[], arrayIndex: int): void
    {
        var current = _head;
        var index = arrayIndex;
        while (current !== null)
        {
            array[index] = current.value;
            index++;
            current = current.next;
        }
    }

    public fun indexOf(item: T): int
    {
        var current = _head;
        var index = 0;
        while (current !== null)
        {
            if (current.value == item) return index;
            current = current.next;
            index++;
        }
        return -1;
    }

    public fun iterate(): IIterator<T>
    {
        return Iterator<T>(this._head);
    }

    public fun removeAt(index: int): bool
    {
        if (index < 0 || index >= this._length) throw IndexOutOfRangeException("Index out of range");
        var current = _head;
        for (var i = 0; i < index; i++)
            current = current.next!!;

        if (current.prev == null)
            _head = current.next;
        else
            current.prev!!.next = current.next;

        if (current.next == null)
            _tail = current.prev;
        else
            current.next!!.prev = current.prev;

        _length--;
        return true;
    }

    public fun remove(item: T): bool
    {
        var current = _head;
        while (current !== null)
        {
            if (current.value == item)
            {
                if (current.prev == null)
                    _head = current.next;
                else
                    current.prev!!.next = current.next;

                if (current.next == null)
                    _tail = current.prev;
                else
                    current.next!!.prev = current.prev;

                _length--;
                return true;
            }
            current = current.next;
        }
        return false;
    }

    public fun clear(): void
    {
        _head = null;
        _tail = null;
        _length = 0;
    }

    inline operator [](self: LinkedList<T>, index: int): T { return self.get(index); }
    inline operator [](self: LinkedList<T>, index: int, value: T): void { self.set(index, value); }
}

public class ReadOnlyList<T> : IReadOnlyList<T>
{
    private let _items: T[];

    public constructor(items: T...)
    {
        _items = items;
    }

    public length: int => _items.length;

    public inline fun get(index : int): T => _items[index];

    public fun indexOf(item : T): int => _items.indexOf(item);

    public fun contains(item : T): bool
    {
        for (value in _items)
        {
            if (value == item)
                return true;
        }
        return false;
    }

    public fun copyTo(array : T[], arrayIndex : int): void
    {
        for (var i = 0; i < _items.length; i++)
        {
            array[arrayIndex + i] = _items[i];
        }
    }

    public inline fun iterate(): IIterator<T> => _items.iterate();
}
