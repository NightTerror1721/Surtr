import surtr.collections.Collection;
import surtr.collections.List;

public value class Sequence<T> : IIterable<T>
{
    private let _provider: () -> IIterator<T>;

    public constructor(provider: () -> IIterator<T>)
    {
        this._provider = provider;
    }

    public static empty: Sequence<T> => Sequence<T>(() => EmptyIterator<T>());
    
    public static fun of(elements: T...): Sequence<T> => Sequence<T>(() => ArrayIterator<T>(elements));

    public inline fun map<U>(mapper : (T) -> U): Sequence<U> => Sequence<U>(() => MapIterator<T, U>(_provider(), mapper));
    
    public inline fun flatMap<U>(mapper : (T) -> Sequence<U>): Sequence<U> => Sequence<U>(() => FlatMapIterator<T, U>(_provider(), mapper));

    public inline fun filter(predicate : (T) -> bool): Sequence<T> => Sequence<T>(() => FilterIterator<T>(_provider(), predicate));

    public inline fun take(count : int): Sequence<T> => Sequence<T>(() => TakeIterator<T>(_provider(), count));

    public inline fun skip(count : int): Sequence<T> => Sequence<T>(() => SkipIterator<T>(_provider(), count));

    public inline fun distinct(): Sequence<T> => Sequence<T>(() => DistinctIterator<T>(_provider()));

    public inline fun sorted(comparator : (T, T) -> int): Sequence<T> => Sequence<T>(() => SortedIterator<T>(_provider(), comparator));

    public inline fun chain(other : Sequence<T>): Sequence<T> => Sequence<T>(() => ChainIterator<T>(_provider(), other._provider()));

    public inline fun zip<U>(other : Sequence<U>): Sequence<(T, U)> => Sequence<(T, U)>(() => ZipIterator<T, U>(_provider(), other._provider()));

    public inline fun enumerate(): Sequence<(int, T)> => Sequence<(int, T)>(() => EnumerateIterator<T>(_provider()));

    public inline fun reverse(): Sequence<T> => Sequence<T>(() => ReverseIterator<T>(_provider()));

    public inline fun cast<U>(): Sequence<U> => Sequence<U>(() => CastIterator<T, U>(_provider()));

    public inline fun safeCast<U>(): Sequence<U> => Sequence<U>(() => SafeCastIterator<T, U>(_provider()));

    public inline fun takeWhile(predicate: (T) -> bool): Sequence<T> => Sequence<T>(() => TakeWhileIterator<T>(_provider(), predicate));

    public inline fun skipWhile(predicate: (T) -> bool): Sequence<T> => Sequence<T>(() => SkipWhileIterator<T>(_provider(), predicate));

    public inline fun onEach(action: (T) -> void): Sequence<T> => Sequence<T>(() => OnEachIterator<T>(_provider(), action));


    public fun forEach(action : (T) -> void): void
    {
        var iter = _provider();
        while (iter.moveNext())
            action(iter.current);
    }

    public fun reduce<U>(reducer : (U, T) -> U, initialValue : U): U
    {
        var result: U = initialValue;
        var iter = _provider();
        while (iter.moveNext())
            result = reducer(result, iter.current);
        return result;
    }

    public fun firstOrNull(): T?
    {
        var iter = _provider();
        if (iter.moveNext())
            return iter.current;
        return null;
    }

    public fun firstOrNull(predicate : (T) -> bool): T?
    {
        var iter = _provider();
        while (iter.moveNext())
        {
            if (predicate(iter.current))
                return iter.current;
        }
        return null;
    }

    public fun any(predicate : (T) -> bool): bool
    {
        var iter = _provider();
        while (iter.moveNext())
        {
            if (predicate(iter.current))
                return true;
        }
        return false;
    }

    public fun all(predicate : (T) -> bool): bool
    {
        var iter = _provider();
        while (iter.moveNext())
        {
            if (!predicate(iter.current))
                return false;
        }
        return true;
    }

    public fun count(): int
    {
        var count: int = 0;
        var iter = _provider();
        while (iter.moveNext()) count++;
        return count;
    }

    public fun toArray(): T[]
    {
        var result: T[] = [];
        var iter = _provider();
        while (iter.moveNext())
            result.push(iter.current);
        return result;
    }

    public fun toList(): List<T>
    {
        var result: List<T> = List<T>();
        var iter = _provider();
        while (iter.moveNext())
            result.add(iter.current);
        return result;
    }

    public override inline fun iterate(): IIterator<T> => _provider();
}

class FilterIterator<T> : IIterator<T>
{
    private let _source: IIterator<T>;
    private let _predicate: (T) -> bool;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>, predicate: (T) -> bool)
    {
        this._source = source;
        this._predicate = predicate;
    }

    public current: T
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _source.current;
        }
    }

    public inline fun moveNext(): bool
    {
        while (_source.moveNext())
        {
            if (_predicate(_source.current))
            {
                _valid = true;
                return true;
            }
        }
        _valid = false;
        return false;
    }
}

class MapIterator<T, U> : IIterator<U>
{
    private let _source: IIterator<T>;
    private let _mapper: (T) -> U;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>, mapper: (T) -> U)
    {
        this._source = source;
        this._mapper = mapper;
    }

    public current: U
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _mapper(_source.current);
        }
    }

    public inline fun moveNext(): bool
    {
        if (_source.moveNext())
        {
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class FlatMapIterator<T, U> : IIterator<U>
{
    private let _source: IIterator<T>;
    private let _mapper: (T) -> Sequence<U>;
    private var _currentIterator: IIterator<U>? = null;

    public constructor(source: IIterator<T>, mapper: (T) -> Sequence<U>)
    {
        this._source = source;
        this._mapper = mapper;
    }

    public current: U
    {
        get
        {
            if (_currentIterator == null)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _currentIterator!!.current;
        }
    }

    public inline fun moveNext(): bool
    {
        while (true)
        {
            if (_currentIterator?.moveNext() ?? false)
                return true;

            if (!_source.moveNext())
                return false;

            _currentIterator = _mapper(_source.current).iterate();
        }
    }
}

class TakeIterator<T> : IIterator<T>
{
    private let _source: IIterator<T>;
    private let _count: int;
    private var _taken: int = 0;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>, count: int)
    {
        this._source = source;
        this._count = count;
    }

    public current: T
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _source.current;
        }
    }

    public inline fun moveNext(): bool
    {
        if (_taken >= _count)
        {
            _valid = false;
            return false;
        }
        if (_source.moveNext())
        {
            _taken++;
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class SkipIterator<T> : IIterator<T>
{
    private let _source: IIterator<T>;
    private let _count: int;
    private var _skipped: int = 0;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>, count: int)
    {
        this._source = source;
        this._count = count;
    }

    public current: T
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _source.current;
        }
    }

    public inline fun moveNext(): bool
    {
        while (_skipped < _count && _source.moveNext())
            _skipped++;
        if (_source.moveNext())
        {
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class DistinctIterator<T> : IIterator<T>
{
    private let _source: IIterator<T>;
    private let _seen: {T: bool} = {};
    private var _valid: bool = false;

    public constructor(source: IIterator<T>)
    {
        this._source = source;
    }

    public current: T
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _source.current;
        }
    }

    public inline fun moveNext(): bool
    {
        while (_source.moveNext())
        {
            if (!_seen.containsKey(_source.current))
            {
                _seen[_source.current] = true;
                _valid = true;
                return true;
            }
        }
        _valid = false;
        return false;
    }
}

class SortedIterator<T> : IIterator<T>
{
    private let _sortedItems: T[];
    private var _index: int = -1;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>, comparator: (T, T) -> int)
    {
        var items: T[] = [];
        while (source.moveNext())
        {
            items.push(source.current);
        }
        items.sort(comparator);
        this._sortedItems = items;
    }

    public current: T
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _sortedItems[_index];
        }
    }

    public inline fun moveNext(): bool
    {
        if (_index + 1 < _sortedItems.length)
        {
            _index++;
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class ChainIterator<T> : IIterator<T>
{
    private let _first: IIterator<T>;
    private let _second: IIterator<T>;
    private var _usingFirst: bool = true;
    private var _valid: bool = false;

    public constructor(first: IIterator<T>, second: IIterator<T>)
    {
        this._first = first;
        this._second = second;
    }

    public current: T
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            if (_usingFirst)
                return _first.current;
            else
                return _second.current;
        }
    }

    public inline fun moveNext(): bool
    {
        if (_usingFirst)
        {
            if (_first.moveNext())
            {
                _valid = true;
                return true;
            }
            else
                _usingFirst = false;
        }
        if (_second.moveNext())
        {
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class ZipIterator<T, U> : IIterator<(T, U)>
{
    private let _first: IIterator<T>;
    private let _second: IIterator<U>;
    private var _valid: bool = false;

    public constructor(first: IIterator<T>, second: IIterator<U>)
    {
        this._first = first;
        this._second = second;
    }

    public current: (T, U)
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return (_first.current, _second.current);
        }
    }

    public inline fun moveNext(): bool
    {
        if (_first.moveNext() && _second.moveNext())
        {
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class EnumerateIterator<T> : IIterator<(int, T)>
{
    private let _source: IIterator<T>;
    private var _index: int = -1;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>)
    {
        this._source = source;
    }

    public current: (int, T)
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return (_index, _source.current);
        }
    }

    public inline fun moveNext(): bool
    {
        if (_source.moveNext())
        {
            _index++;
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class ReverseIterator<T> : IIterator<T>
{
    private let _items: T[];
    private var _index: int;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>)
    {
        var items: T[] = [];
        while (source.moveNext())
        {
            items.push(source.current);
        }
        this._items = items;
        this._index = items.length; // Start after the last index
    }

    public current: T
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _items[_index];
        }
    }

    public inline fun moveNext(): bool
    {
        if (_index > 0)
        {
            _index--;
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class CastIterator<T, U> : IIterator<U>
{
    private let _source: IIterator<T>;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>)
    {
        this._source = source;
    }

    public current: U
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _source.current as U;
        }
    }

    public inline fun moveNext(): bool
    {
        if (_source.moveNext())
        {
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class SafeCastIterator<T, U> : IIterator<U>
{
    private let _source: IIterator<T>;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>)
    {
        this._source = source;
    }

    public current: U
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _source.current as? U ?? throw InvalidCastException("Element is not of type U.");
        }
    }

    public inline fun moveNext(): bool
    {
        if (_source.moveNext())
        {
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class TakeWhileIterator<T> : IIterator<T>
{
    private let _source: IIterator<T>;
    private let _predicate: (T) -> bool;
    private var _stopped: bool = false;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>, predicate: (T) -> bool)
    {
        this._source = source;
        this._predicate = predicate;
    }

    public current: T
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _source.current;
        }
    }

    public inline fun moveNext(): bool
    {
        if (_stopped)
        {
            _valid = false;
            return false;
        }
        if (_source.moveNext())
        {
            if (_predicate(_source.current))
            {
                _valid = true;
                return true;
            }
            else
            {
                _stopped = true;
                _valid = false;
                return false;
            }
        }
        _valid = false;
        return false;
    }
}

class SkipWhileIterator<T> : IIterator<T>
{
    private let _source: IIterator<T>;
    private let _predicate: (T) -> bool;
    private var _skipping: bool = true;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>, predicate: (T) -> bool)
    {
        this._source = source;
        this._predicate = predicate;
    }

    public current: T
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _source.current;
        }
    }

    public inline fun moveNext(): bool
    {
        while (_source.moveNext())
        {
            if (_skipping)
            {
                if (!_predicate(_source.current))
                {
                    _skipping = false;
                    _valid = true;
                    return true;
                }
            }
            else
            {
                _valid = true;
                return true;
            }
        }
        _valid = false;
        return false;
    }
}

class OnEachIterator<T> : IIterator<T>
{
    private let _source: IIterator<T>;
    private let _action: (T) -> void;
    private var _valid: bool = false;

    public constructor(source: IIterator<T>, action: (T) -> void)
    {
        this._source = source;
        this._action = action;
    }

    public current: T
    {
        get
        {
            if (!_valid)
                throw InvalidOperationException("No current element. Call moveNext() first.");
            return _source.current;
        }
    }

    public inline fun moveNext(): bool
    {
        if (_source.moveNext())
        {
            _action(_source.current);
            _valid = true;
            return true;
        }
        _valid = false;
        return false;
    }
}

class ArrayIterator<T> : IIterator<T>
{
    private let _array: T[];
    private var _index: int = -1;

    public constructor(array: T[])
    {
        this._array = array;
    }

    public current: T
    {
        get
        {
            if (_index < 0 || _index >= _array.length)
                throw InvalidOperationException("Iterator is out of bounds.");
            return _array[_index];
        }
    }

    public inline fun moveNext(): bool
    {
        if (_index + 1 < _array.length)
        {
            _index++;
            return true;
        }
        return false;
    }
}

class SingleIterator<T> : IIterator<T>
{
    private let _value: T;
    private var _hasMoved: bool = false;

    public constructor(value: T)
    {
        this._value = value;
    }

    public inline current: T => _value;

    public inline fun moveNext(): bool
        {
            if (!_hasMoved)
            {
                _hasMoved = true;
                return true;
            }
            return false;
        }
    }

class EmptyIterator<T> : IIterator<T>
{
    public constructor() {}

    public inline current: T
    {
        get { throw InvalidOperationException("No current element. The iterator is empty."); }
    }

    public inline fun moveNext(): bool => false;
}
