import surtr.collections.Collection;
import surtr.collections.List;

public value class Sequence<T> : IIterable<T>
{
    private let _provider: () -> IIterator<T>;

    public constructor(provider: () -> IIterator<T>)
    {
        this._provider = provider;
    }

    public static empty: Sequence<T> => Sequence<T>(() => EmptyIterator<T>());

    public static fun of(elements: T...): Sequence<T> => Sequence<T>(() => seqOf<T>(elements));

    public inline fun map<U>(mapper : (T) -> U): Sequence<U> => Sequence<U>(() => seqMap<T, U>(_provider(), mapper));

    public inline fun flatMap<U>(mapper : (T) -> Sequence<U>): Sequence<U> => Sequence<U>(() => seqFlatMap<T, U>(_provider(), mapper));

    public inline fun filter(predicate : (T) -> bool): Sequence<T> => Sequence<T>(() => seqFilter<T>(_provider(), predicate));

    public inline fun take(count : int): Sequence<T> => Sequence<T>(() => seqTake<T>(_provider(), count));

    public inline fun skip(count : int): Sequence<T> => Sequence<T>(() => seqSkip<T>(_provider(), count));

    public inline fun distinct(): Sequence<T> => Sequence<T>(() => seqDistinct<T>(_provider()));

    public inline fun sorted(comparator : (T, T) -> int): Sequence<T> => Sequence<T>(() => seqSorted<T>(_provider(), comparator));

    public inline fun chain(other : Sequence<T>): Sequence<T> => Sequence<T>(() => seqChain<T>(_provider(), other._provider()));

    public inline fun zip<U>(other : Sequence<U>): Sequence<(T, U)> => Sequence<(T, U)>(() => seqZip<T, U>(_provider(), other._provider()));

    public inline fun enumerate(): Sequence<(int, T)> => Sequence<(int, T)>(() => seqEnumerate<T>(_provider()));

    public inline fun reverse(): Sequence<T> => Sequence<T>(() => seqReverse<T>(_provider()));

    public inline fun cast<U>(): Sequence<U> => Sequence<U>(() => seqCast<T, U>(_provider()));

    public inline fun safeCast<U>(): Sequence<U> => Sequence<U>(() => seqSafeCast<T, U>(_provider()));

    public inline fun takeWhile(predicate: (T) -> bool): Sequence<T> => Sequence<T>(() => seqTakeWhile<T>(_provider(), predicate));

    public inline fun skipWhile(predicate: (T) -> bool): Sequence<T> => Sequence<T>(() => seqSkipWhile<T>(_provider(), predicate));

    public inline fun onEach(action: (T) -> void): Sequence<T> => Sequence<T>(() => seqOnEach<T>(_provider(), action));


    public fun forEach(action : (T) -> void): void
    {
        var iter = _provider();
        while (iter.moveNext())
            action(iter.current);
    }

    public fun reduce<U>(reducer : (U, T) -> U, initialValue : U): U
    {
        var result: U = initialValue;
        var iter = _provider();
        while (iter.moveNext())
            result = reducer(result, iter.current);
        return result;
    }

    public fun firstOrNull(): T?
    {
        var iter = _provider();
        if (iter.moveNext())
            return iter.current;
        return null;
    }

    public fun firstOrNull(predicate : (T) -> bool): T?
    {
        var iter = _provider();
        while (iter.moveNext())
        {
            if (predicate(iter.current))
                return iter.current;
        }
        return null;
    }

    public fun any(predicate : (T) -> bool): bool
    {
        var iter = _provider();
        while (iter.moveNext())
        {
            if (predicate(iter.current))
                return true;
        }
        return false;
    }

    public fun all(predicate : (T) -> bool): bool
    {
        var iter = _provider();
        while (iter.moveNext())
        {
            if (!predicate(iter.current))
                return false;
        }
        return true;
    }

    public fun count(): int
    {
        var count: int = 0;
        var iter = _provider();
        while (iter.moveNext()) count++;
        return count;
    }

    public fun toArray(): T[]
    {
        var result: T[] = [];
        var iter = _provider();
        while (iter.moveNext())
            result.push(iter.current);
        return result;
    }

    public fun toList(): List<T>
    {
        var result: List<T> = List<T>();
        var iter = _provider();
        while (iter.moveNext())
            result.add(iter.current);
        return result;
    }

    public inline fun iterate(): IIterator<T> => _provider();
}

private generator seqOf<T>(items: T[]): T
{
    yield from items;
}

private generator seqMap<T, U>(source: IIterator<T>, mapper: (T) -> U): U
{
    try
    {
        while (source.moveNext())
        {
            yield mapper(source.current);
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqFlatMap<T, U>(source: IIterator<T>, mapper: (T) -> Sequence<U>): U
{
    try
    {
        while (source.moveNext())
        {
            yield from mapper(source.current);
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqFilter<T>(source: IIterator<T>, predicate: (T) -> bool): T
{
    try
    {
        while (source.moveNext())
        {
            if (predicate(source.current))
            {
                yield source.current;
            }
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqTake<T>(source: IIterator<T>, count: int): T
{
    var taken: int = 0;
    try
    {
        while (taken < count && source.moveNext())
        {
            taken++;
            yield source.current;
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqSkip<T>(source: IIterator<T>, count: int): T
{
    var skipped: int = 0;
    try
    {
        while (skipped < count && source.moveNext())
        {
            skipped++;
        }
        while (source.moveNext())
        {
            yield source.current;
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqDistinct<T>(source: IIterator<T>): T
{
    let seen: {T: bool} = {};
    try
    {
        while (source.moveNext())
        {
            if (!seen.containsKey(source.current))
            {
                seen[source.current] = true;
                yield source.current;
            }
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqSorted<T>(source: IIterator<T>, comparator: (T, T) -> int): T
{
    var items: T[] = [];
    try
    {
        while (source.moveNext())
        {
            items.push(source.current);
        }
    }
    finally
    {
        source.dispose();
    }
    items.sort(comparator);
    for (x in items)
    {
        yield x;
    }
}

private generator seqChain<T>(first: IIterator<T>, second: IIterator<T>): T
{
    try
    {
        while (first.moveNext())
        {
            yield first.current;
        }
        while (second.moveNext())
        {
            yield second.current;
        }
    }
    finally
    {
        first.dispose();
        second.dispose();
    }
}

private generator seqZip<T, U>(first: IIterator<T>, second: IIterator<U>): (T, U)
{
    try
    {
        while (first.moveNext() && second.moveNext())
        {
            yield (first.current, second.current);
        }
    }
    finally
    {
        first.dispose();
        second.dispose();
    }
}

private generator seqEnumerate<T>(source: IIterator<T>): (int, T)
{
    var index: int = 0;
    try
    {
        while (source.moveNext())
        {
            yield (index, source.current);
            index++;
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqReverse<T>(source: IIterator<T>): T
{
    var items: T[] = [];
    try
    {
        while (source.moveNext())
        {
            items.push(source.current);
        }
    }
    finally
    {
        source.dispose();
    }
    var index: int = items.length;
    while (index > 0)
    {
        index--;
        yield items[index];
    }
}

private generator seqCast<T, U>(source: IIterator<T>): U
{
    try
    {
        while (source.moveNext())
        {
            yield source.current as U;
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqSafeCast<T, U>(source: IIterator<T>): U
{
    try
    {
        while (source.moveNext())
        {
            yield source.current as? U ?? throw InvalidCastException("Element is not of type U.");
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqTakeWhile<T>(source: IIterator<T>, predicate: (T) -> bool): T
{
    var stopped: bool = false;
    try
    {
        while (!stopped && source.moveNext())
        {
            if (predicate(source.current))
            {
                yield source.current;
            }
            else
            {
                stopped = true;
            }
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqSkipWhile<T>(source: IIterator<T>, predicate: (T) -> bool): T
{
    var skipping: bool = true;
    try
    {
        while (source.moveNext())
        {
            if (skipping)
            {
                if (!predicate(source.current))
                {
                    skipping = false;
                    yield source.current;
                }
            }
            else
            {
                yield source.current;
            }
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqOnEach<T>(source: IIterator<T>, action: (T) -> void): T
{
    try
    {
        while (source.moveNext())
        {
            action(source.current);
            yield source.current;
        }
    }
    finally
    {
        source.dispose();
    }
}

class EmptyIterator<T> : IIterator<T>
{
    public constructor() {}

    public inline current: T
    {
        get { throw InvalidOperationException("No current element. The iterator is empty."); }
    }

    // Nothing held that outlives this cursor, so the contract slot is filled and empty.
    public fun dispose(): void { }

    public inline fun moveNext(): bool => false;
}
