import surtr.collections.Collection;
import surtr.collections.List;
import surtr.collections.Set;
import surtr.collections.Map;

public value class Sequence<T> : IIterable<T>
{
    private let _provider: () -> IIterator<T>;

    public constructor(provider: () -> IIterator<T>)
    {
        this._provider = provider;
    }

    public static empty: Sequence<T> => Sequence<T>(() => EmptyIterator<T>());

    public static fun of(elements: T...): Sequence<T> => Sequence<T>(() => seqOf<T>(elements));

    public inline fun map<U>(mapper : (T) -> U): Sequence<U> => Sequence<U>(() => seqMap<T, U>(_provider(), mapper));

    public inline fun flatMap<U>(mapper : (T) -> Sequence<U>): Sequence<U> => Sequence<U>(() => seqFlatMap<T, U>(_provider(), mapper));

    public inline fun filter(predicate : (T) -> bool): Sequence<T> => Sequence<T>(() => seqFilter<T>(_provider(), predicate));

    public inline fun take(count : int): Sequence<T> => Sequence<T>(() => seqTake<T>(_provider(), count));

    public inline fun skip(count : int): Sequence<T> => Sequence<T>(() => seqSkip<T>(_provider(), count));

    public inline fun distinct(): Sequence<T> => Sequence<T>(() => seqDistinct<T>(_provider()));

    public inline fun sorted(comparator : (T, T) -> int): Sequence<T> => Sequence<T>(() => seqSorted<T>(_provider(), comparator));

    public inline fun chain(other : Sequence<T>): Sequence<T> => Sequence<T>(() => seqChain<T>(_provider(), other._provider()));

    public inline fun zip<U>(other : Sequence<U>): Sequence<(T, U)> => Sequence<(T, U)>(() => seqZip<T, U>(_provider(), other._provider()));

    public inline fun enumerate(): Sequence<(int, T)> => Sequence<(int, T)>(() => seqEnumerate<T>(_provider()));

    public inline fun reverse(): Sequence<T> => Sequence<T>(() => seqReverse<T>(_provider()));

    public inline fun cast<U>(): Sequence<U> => Sequence<U>(() => seqCast<T, U>(_provider()));

    public inline fun safeCast<U>(): Sequence<U> => Sequence<U>(() => seqSafeCast<T, U>(_provider()));

    public inline fun takeWhile(predicate: (T) -> bool): Sequence<T> => Sequence<T>(() => seqTakeWhile<T>(_provider(), predicate));

    public inline fun skipWhile(predicate: (T) -> bool): Sequence<T> => Sequence<T>(() => seqSkipWhile<T>(_provider(), predicate));

    public inline fun onEach(action: (T) -> void): Sequence<T> => Sequence<T>(() => seqOnEach<T>(_provider(), action));

    public inline fun distinctBy<K>(keySelector: (T) -> K): Sequence<T> => Sequence<T>(() => seqDistinctBy<T, K>(_provider(), keySelector));

    // Takes an explicit comparator over K, the same way sorted() takes one over T, rather than
    // constraining K to some IComparable<K> - keeps this consistent with sorted() and sidesteps
    // relying on a constrained-generics path this file has no other reason to exercise.
    public inline fun sortBy<K>(keySelector: (T) -> K, comparator: (K, K) -> int): Sequence<T> => Sequence<T>(() => seqSortBy<T, K>(_provider(), keySelector, comparator));

    public inline fun sortByDescending<K>(keySelector: (T) -> K, comparator: (K, K) -> int): Sequence<T> => Sequence<T>(() => seqSortBy<T, K>(_provider(), keySelector, (a, b) => -comparator(a, b)));


    public fun forEach(action : (T) -> void): void
    {
        var iter = _provider();
        while (iter.moveNext())
            action(iter.current);
    }

    public fun reduce<U>(reducer : (U, T) -> U, initialValue : U): U
    {
        var result: U = initialValue;
        var iter = _provider();
        while (iter.moveNext())
            result = reducer(result, iter.current);
        return result;
    }

    public fun firstOrNull(): T?
    {
        var iter = _provider();
        if (iter.moveNext())
            return iter.current;
        return null;
    }

    public fun firstOrNull(predicate : (T) -> bool): T?
    {
        var iter = _provider();
        while (iter.moveNext())
        {
            if (predicate(iter.current))
                return iter.current;
        }
        return null;
    }

    public fun any(predicate : (T) -> bool): bool
    {
        var iter = _provider();
        while (iter.moveNext())
        {
            if (predicate(iter.current))
                return true;
        }
        return false;
    }

    public fun all(predicate : (T) -> bool): bool
    {
        var iter = _provider();
        while (iter.moveNext())
        {
            if (!predicate(iter.current))
                return false;
        }
        return true;
    }

    public fun count(): int
    {
        var count: int = 0;
        var iter = _provider();
        while (iter.moveNext()) count++;
        return count;
    }

    /// The smallest element by `comparator`, or `null` if the sequence is empty.
    public fun min(comparator: (T, T) -> int): T?
    {
        var iter = _provider();
        if (!iter.moveNext()) return null;
        var best = iter.current;
        while (iter.moveNext())
        {
            if (comparator(iter.current, best) < 0) best = iter.current;
        }
        return best;
    }

    /// The largest element by `comparator`, or `null` if the sequence is empty.
    public fun max(comparator: (T, T) -> int): T?
    {
        var iter = _provider();
        if (!iter.moveNext()) return null;
        var best = iter.current;
        while (iter.moveNext())
        {
            if (comparator(iter.current, best) > 0) best = iter.current;
        }
        return best;
    }

    /// Groups elements by `keySelector`, preserving each group's encounter order.
    public fun groupBy<K>(keySelector: (T) -> K): Map<K, List<T>>
    {
        var result = Map<K, List<T>>();
        var iter = _provider();
        while (iter.moveNext())
        {
            let key = keySelector(iter.current);
            if (!result.containsKey(key))
                result.set(key, List<T>());
            result.get(key).add(iter.current);
        }
        return result;
    }

    // Takes an explicit (T) -> string selector rather than assuming T has a toString(): T is
    // otherwise unconstrained here (same reasoning as sortBy's explicit comparator above), and
    // object.toString() is only reachable on a T declared <T : object>, which nothing else in this
    // class needs.
    public fun joinToString(separator: string, selector: (T) -> string): string
    {
        let parts = map(selector).toArray();
        return string.join(separator, parts);
    }

    public fun elementAt(index: int): T
    {
        if (index < 0) throw IndexOutOfRangeException("Index out of range");
        var i = 0;
        var iter = _provider();
        while (iter.moveNext())
        {
            if (i == index) return iter.current;
            i += 1;
        }
        throw IndexOutOfRangeException("Index out of range");
    }

    public fun last(): T
    {
        var iter = _provider();
        if (!iter.moveNext()) throw InvalidOperationException("Sequence is empty.");
        var result = iter.current;
        while (iter.moveNext())
            result = iter.current;
        return result;
    }

    public fun lastOrNull(): T?
    {
        var iter = _provider();
        if (!iter.moveNext()) return null;
        var result = iter.current;
        while (iter.moveNext())
            result = iter.current;
        return result;
    }

    public fun toArray(): T[]
    {
        var result: T[] = [];
        var iter = _provider();
        while (iter.moveNext())
            result.push(iter.current);
        return result;
    }

    public fun toList(): List<T>
    {
        var result: List<T> = List<T>();
        var iter = _provider();
        while (iter.moveNext())
            result.add(iter.current);
        return result;
    }

    public fun toSet(): Set<T>
    {
        var result: Set<T> = Set<T>();
        var iter = _provider();
        while (iter.moveNext())
            result.add(iter.current);
        return result;
    }

    public fun toReadOnlySet(): IReadOnlySet<T>
    {
        var result: Set<T> = Set<T>();
        var iter = _provider();
        while (iter.moveNext())
            result.add(iter.current);
        return ReadOnlySet<T>(result);
    }

    public inline fun iterate(): IIterator<T> => _provider();
}

// Fase 8, §6.2/O4 + §6.3/P6: once a T is bounded by the built-in IComparable<T>, min()/max()/sorted()
// need no comparator written out by hand - the same trade §6.2/O4 makes for List<T>.sortNatural().
// Named minNatural/maxNatural/sortedNatural rather than second overloads of min/max/sorted:
// Sequence<T> already declares real (non-extension) members by those names, and a real member of a
// name blocks every extension of that same name on the type regardless of arity - the explicit-
// comparator forms above stay exactly as useful as before for a T with no natural order.
public extension<T: IComparable<T>> Sequence<T>
{
    fun minNatural(self: Sequence<T>): T? => self.min((a, b) => a.compareTo(b));

    fun maxNatural(self: Sequence<T>): T? => self.max((a, b) => a.compareTo(b));

    fun sortedNatural(self: Sequence<T>): Sequence<T> => self.sorted((a, b) => a.compareTo(b));
}

// Fase 8, §6.2/O2/O3: once T is bounded by object, a join/display form needs no selector written
// out by hand - it can call the real toString() every object has. Named toDisplayString rather than
// an arity overload of joinToString: Sequence<T> already declares a real (non-extension)
// joinToString(separator, selector) instance method, and a real member of a name blocks every
// extension of that same name on the type regardless of arity - the same rule that makes
// List<T>.toDisplayString() a new name rather than an override of the inherited toString().
public extension<T: object> Sequence<T>
{
    /// A debug representation, e.g. `[1, 2, 3]` - the same shape List<T>.toDisplayString() gives.
    fun toDisplayString(self: Sequence<T>): string => "[" + self.joinToString(", ", (x) => x.toString()) + "]";
}

public extension<T: object> IIterable<T>
{
    fun toDisplayString(self: IIterable<T>): string => self.asSequence().toDisplayString();
}

// int/float only, rather than members of Sequence<T> itself: summing/averaging needs a concrete
// numeric element type to add, and this language has no numeric-trait constraint to ask for one
// generically - two concrete extensions is the same trade sorted()/min()/max() avoid by taking an
// explicit comparator instead, just on the arithmetic operator rather than a comparison.
//
// Named sumInts/sumFloats rather than a shared sum() overloaded per element type: Sequence<T> is a
// single-field value class (its one field is the () -> IIterator<T> provider, Â§2.9), so it erases
// AT THE SIGNATURE LEVEL to that field's own type regardless of T - Sequence<int> and Sequence<float>
// both erase a `self: Sequence<...>` parameter to the same closure shape, so `sum(self: Sequence
// <int>)` and `sum(self: Sequence<float>)` collide as the same emitted signature (confirmed: SURTR4001
// "already declares a member with the signature 'sum(...)'" without a distinct name per type).
public extension Sequence<int>
{
    fun sumInts(self: Sequence<int>): int
    {
        var total = 0;
        for (x in self) total += x;
        return total;
    }

    fun averageInts(self: Sequence<int>): float
    {
        var total = 0;
        var count = 0;
        for (x in self) { total += x; count += 1; }
        if (count == 0) return 0.0;
        return total.toFloat() / count.toFloat();
    }
}

public extension Sequence<float>
{
    fun sumFloats(self: Sequence<float>): float
    {
        var total = 0.0;
        for (x in self) total += x;
        return total;
    }

    fun averageFloats(self: Sequence<float>): float
    {
        var total = 0.0;
        var count = 0;
        for (x in self) { total += x; count += 1; }
        if (count == 0) return 0.0;
        return total / count.toFloat();
    }
}

public extension<T> IIterable<T>
{
    fun asSequence(self: IIterable<T>): Sequence<T> => Sequence<T>(() => self.iterate());

    fun forEach(self: IIterable<T>, action: (T) -> void): void => self.asSequence().forEach(action);

    fun min(self: IIterable<T>, comparator: (T, T) -> int): T? => self.asSequence().min(comparator);

    fun max(self: IIterable<T>, comparator: (T, T) -> int): T? => self.asSequence().max(comparator);

    fun joinToString(self: IIterable<T>, separator: string, selector: (T) -> string): string => self.asSequence().joinToString(separator, selector);

    fun elementAt(self: IIterable<T>, index: int): T => self.asSequence().elementAt(index);

    fun last(self: IIterable<T>): T => self.asSequence().last();

    fun lastOrNull(self: IIterable<T>): T? => self.asSequence().lastOrNull();

    fun firstOrNull(self: IIterable<T>): T? => self.asSequence().firstOrNull();

    fun firstOrNull(self: IIterable<T>, predicate: (T) -> bool): T? => self.asSequence().firstOrNull(predicate);

    fun any(self: IIterable<T>, predicate: (T) -> bool): bool => self.asSequence().any(predicate);

    fun all(self: IIterable<T>, predicate: (T) -> bool): bool => self.asSequence().all(predicate);

    fun count(self: IIterable<T>): int => self.asSequence().count();

    fun toArray(self: IIterable<T>): T[] => self.asSequence().toArray();

    fun toList(self: IIterable<T>): List<T> => self.asSequence().toList();

    fun toSet(self: IIterable<T>): Set<T> => self.asSequence().toSet();

    fun toReadOnlySet(self: IIterable<T>): IReadOnlySet<T> => self.asSequence().toReadOnlySet();
}

public extension<T, U> IIterable<T>
{
    fun reduce(self: IIterable<T>, reducer: (U, T) -> U, initialValue: U): U => self.asSequence().reduce(reducer, initialValue);

    fun groupBy(self: IIterable<T>, keySelector: (T) -> U): Map<U, List<T>> => self.asSequence().groupBy(keySelector);
}

public extension IIterable<int>
{
    fun sumInts(self: IIterable<int>): int => self.asSequence().sumInts();

    fun averageInts(self: IIterable<int>): float => self.asSequence().averageInts();
}

public extension IIterable<float>
{
    fun sumFloats(self: IIterable<float>): float => self.asSequence().sumFloats();

    fun averageFloats(self: IIterable<float>): float => self.asSequence().averageFloats();
}

private generator seqOf<T>(items: T[]): T
{
    yield from items;
}

private generator seqMap<T, U>(source: IIterator<T>, mapper: (T) -> U): U
{
    try
    {
        while (source.moveNext())
        {
            yield mapper(source.current);
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqFlatMap<T, U>(source: IIterator<T>, mapper: (T) -> Sequence<U>): U
{
    try
    {
        while (source.moveNext())
        {
            yield from mapper(source.current);
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqFilter<T>(source: IIterator<T>, predicate: (T) -> bool): T
{
    try
    {
        while (source.moveNext())
        {
            if (predicate(source.current))
            {
                yield source.current;
            }
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqTake<T>(source: IIterator<T>, count: int): T
{
    var taken: int = 0;
    try
    {
        while (taken < count && source.moveNext())
        {
            taken++;
            yield source.current;
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqSkip<T>(source: IIterator<T>, count: int): T
{
    var skipped: int = 0;
    try
    {
        while (skipped < count && source.moveNext())
        {
            skipped++;
        }
        while (source.moveNext())
        {
            yield source.current;
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqDistinct<T>(source: IIterator<T>): T
{
    let seen: {T: bool} = {};
    try
    {
        while (source.moveNext())
        {
            if (!seen.containsKey(source.current))
            {
                seen[source.current] = true;
                yield source.current;
            }
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqSorted<T>(source: IIterator<T>, comparator: (T, T) -> int): T
{
    var items: T[] = [];
    try
    {
        while (source.moveNext())
        {
            items.push(source.current);
        }
    }
    finally
    {
        source.dispose();
    }
    items.sort(comparator);
    for (x in items)
    {
        yield x;
    }
}

private generator seqDistinctBy<T, K>(source: IIterator<T>, keySelector: (T) -> K): T
{
    let seen: {K: bool} = {};
    try
    {
        while (source.moveNext())
        {
            let key = keySelector(source.current);
            if (!seen.containsKey(key))
            {
                seen[key] = true;
                yield source.current;
            }
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqSortBy<T, K>(source: IIterator<T>, keySelector: (T) -> K, comparator: (K, K) -> int): T
{
    var items: T[] = [];
    try
    {
        while (source.moveNext())
        {
            items.push(source.current);
        }
    }
    finally
    {
        source.dispose();
    }
    items.sort((a, b) => comparator(keySelector(a), keySelector(b)));
    for (x in items)
    {
        yield x;
    }
}

private generator seqChain<T>(first: IIterator<T>, second: IIterator<T>): T
{
    try
    {
        while (first.moveNext())
        {
            yield first.current;
        }
        while (second.moveNext())
        {
            yield second.current;
        }
    }
    finally
    {
        first.dispose();
        second.dispose();
    }
}

private generator seqZip<T, U>(first: IIterator<T>, second: IIterator<U>): (T, U)
{
    try
    {
        while (first.moveNext() && second.moveNext())
        {
            yield (first.current, second.current);
        }
    }
    finally
    {
        first.dispose();
        second.dispose();
    }
}

private generator seqEnumerate<T>(source: IIterator<T>): (int, T)
{
    var index: int = 0;
    try
    {
        while (source.moveNext())
        {
            yield (index, source.current);
            index++;
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqReverse<T>(source: IIterator<T>): T
{
    var items: T[] = [];
    try
    {
        while (source.moveNext())
        {
            items.push(source.current);
        }
    }
    finally
    {
        source.dispose();
    }
    var index: int = items.length;
    while (index > 0)
    {
        index--;
        yield items[index];
    }
}

private generator seqCast<T, U>(source: IIterator<T>): U
{
    try
    {
        while (source.moveNext())
        {
            yield source.current as U;
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqSafeCast<T, U>(source: IIterator<T>): U
{
    try
    {
        while (source.moveNext())
        {
            yield source.current as? U ?? throw InvalidCastException("Element is not of type U.");
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqTakeWhile<T>(source: IIterator<T>, predicate: (T) -> bool): T
{
    var stopped: bool = false;
    try
    {
        while (!stopped && source.moveNext())
        {
            if (predicate(source.current))
            {
                yield source.current;
            }
            else
            {
                stopped = true;
            }
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqSkipWhile<T>(source: IIterator<T>, predicate: (T) -> bool): T
{
    var skipping: bool = true;
    try
    {
        while (source.moveNext())
        {
            if (skipping)
            {
                if (!predicate(source.current))
                {
                    skipping = false;
                    yield source.current;
                }
            }
            else
            {
                yield source.current;
            }
        }
    }
    finally
    {
        source.dispose();
    }
}

private generator seqOnEach<T>(source: IIterator<T>, action: (T) -> void): T
{
    try
    {
        while (source.moveNext())
        {
            action(source.current);
            yield source.current;
        }
    }
    finally
    {
        source.dispose();
    }
}

class EmptyIterator<T> : IIterator<T>
{
    public constructor() {}

    public inline current: T
    {
        get { throw InvalidOperationException("No current element. The iterator is empty."); }
    }

    // Nothing held that outlives this cursor, so the contract slot is filled and empty.
    public fun dispose(): void { }

    public inline fun moveNext(): bool => false;
}
