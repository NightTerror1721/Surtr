import surtr.collections.Collection;

public interface IReadOnlySet<T> default ReadOnlySet<T> : IReadOnlyCollection<T>
{
    isEmpty: bool { get; }

    fun isSubsetOf(other: IReadOnlySet<T>): bool;
    fun isSupersetOf(other: IReadOnlySet<T>): bool;
    fun isProperSupersetOf(other: IReadOnlySet<T>): bool;
    fun isProperSubsetOf(other: IReadOnlySet<T>): bool;

    fun overlaps(other: IReadOnlySet<T>): bool;
    fun equals(other: IReadOnlySet<T>): bool;
}

public interface ISet<T> default Set<T> : IReadOnlySet<T>, ICollection<T>
{
    isEmpty: bool { get; }

    fun unionWith(other: ISet<T>): void;
    fun intersectWith(other: ISet<T>): void;
    fun exceptWith(other: ISet<T>): void;
    fun symmetricExceptWith(other: ISet<T>): void;
}

public class ReadOnlySet<T> : IReadOnlySet<T>
{
    protected let _dict: {T: bool};

    public constructor()
    {
        _dict = {};
    }

    public constructor(collection: IIterable<T>)
    {
        _dict = {};
        for (item in collection)
            _dict[item] = true;
    }

    public constructor(items: T...)
    {
        _dict = {};
        for (item in items)
            _dict[item] = true;
    }

    public constructor() { }
    each (item: T)
    {
        _dict[item] = true;
    }

    public inline length: int => _dict.length;
    public inline isEmpty: bool => _dict.length == 0;

    public inline fun contains(item : T): bool
    {
        return _dict.containsKey(item);
    }

    public fun isSubsetOf(other : IReadOnlySet<T>): bool
    {
        for (item in this)
        {
            if (!other.contains(item))
                return false;
        }
        return true;
    }

    public fun isSupersetOf(other : IReadOnlySet<T>): bool
    {
        for (item in other)
        {
            if (!contains(item))
                return false;
        }
        return true;
    }

    public fun isProperSupersetOf(other : IReadOnlySet<T>): bool
    {
        if (length <= other.length)
            return false;
        return isSupersetOf(other);
    }
    
    public fun isProperSubsetOf(other : IReadOnlySet<T>): bool
    {
        if (length >= other.length)
            return false;
        return isSubsetOf(other);
    }

    public fun overlaps(other : IReadOnlySet<T>): bool
    {
        for (item in this)
        {
            if (other.contains(item))
                return true;
        }
        return false;
    }

    public fun equals(other : IReadOnlySet<T>): bool
    {
        if (length != other.length)
            return false;
        return isSubsetOf(other);
    }
    
    public fun copyTo(array : T[], arrayIndex : int): void
    {
        // Only `< 0` is checked here, matching List.copyTo: `arrayIndex == array.length` is valid
        // when there is nothing to copy (an empty set into an empty array), and the space check
        // below already rejects it once `length > 0`.
        if (arrayIndex < 0)
            throw IndexOutOfRangeException("arrayIndex is out of range.");
        if (array.length - arrayIndex < length)
            throw ArgumentException("The number of elements in the source set is greater than the available space from arrayIndex to the end of the destination array.");

        var i = arrayIndex;
        for (item in this)
        {
            array[i] = item;
            i += 1;
        }
    }

    public inline fun iterate(): IIterator<T>
    {
        return Iterator(_dict);
    }

    private sealed class Iterator<T> : IIterator<T>
    {
        private var _items: T[];
        private var _index: int;

        public constructor(dict: {T: bool})
        {
            _items = dict.keys();
            _index = -1;
        }

        public current: T
        {
            get
            {
                if (_index < 0 || _index >= _items.length)
                    throw InvalidOperationException("Iterator is not at a valid position.");
                return _items[_index];
            }
        }

        // Nothing held that outlives this cursor, so the contract slot is filled and empty.
        public fun dispose(): void { }

        public fun moveNext(): bool
        {
            if (_index + 1 < _items.length)
            {
                _index += 1;
                return true;
            }
            return false;
        }
    }

    inline operator &(left: ReadOnlySet<T>, right: IReadOnlySet<T>): ReadOnlySet<T>
    {
        return intersect(left, right);
    }
    inline operator &(left: IReadOnlySet<T>, right: ReadOnlySet<T>): ReadOnlySet<T>
    {
        return intersect(left, right);
    }

    inline operator |(left: ReadOnlySet<T>, right: IReadOnlySet<T>): ReadOnlySet<T>
    {
        return union(left, right);
    }
    inline operator |(left: IReadOnlySet<T>, right: ReadOnlySet<T>): ReadOnlySet<T>
    {
        return union(left, right);
    }

    inline operator -(left: ReadOnlySet<T>, right: IReadOnlySet<T>): ReadOnlySet<T>
    {
        return except(left, right);
    }
    inline operator -(left: IReadOnlySet<T>, right: ReadOnlySet<T>): ReadOnlySet<T>
    {
        return except(left, right);
    }

    inline operator ^(left: ReadOnlySet<T>, right: IReadOnlySet<T>): ReadOnlySet<T>
    {
        return symmetricExcept(left, right);
    }
    inline operator ^(left: IReadOnlySet<T>, right: ReadOnlySet<T>): ReadOnlySet<T>
    {
        return symmetricExcept(left, right);
    }

    public static inline fun union(left: IReadOnlySet<T>, right: IReadOnlySet<T>): ReadOnlySet<T>
    {
        return ReadOnlySet(Set<T>.union(left, right));
    }

    public static inline fun intersect(left: IReadOnlySet<T>, right: IReadOnlySet<T>): ReadOnlySet<T>
    {
        return ReadOnlySet(Set<T>.intersect(left, right));
    }

    public static inline fun except(left: IReadOnlySet<T>, right: IReadOnlySet<T>): ReadOnlySet<T>
    {
        return ReadOnlySet(Set<T>.except(left, right));
    }

    public static inline fun symmetricExcept(left: IReadOnlySet<T>, right: IReadOnlySet<T>): ReadOnlySet<T>
    {
        return ReadOnlySet(Set<T>.symmetricExcept(left, right));
    }
}

public class Set<T> : ReadOnlySet<T>, ISet<T>
{
    public inline isReadOnly: bool => false;

    public constructor() : super() {}

    public constructor(collection: IIterable<T>) : super(collection) {}

    public constructor(items: T...) : super(items) {}

    public constructor() : super() { }
    each (item: T)
    {
        _dict[item] = true;
    }

    public static inline fun of(): Set<T> => Set<T>();
    public static inline fun of(item: T): Set<T> => Set<T>(item);
    public static inline fun of(item1: T, item2: T): Set<T> => Set<T>(item1, item2);
    public static inline fun of(item1: T, item2: T, item3: T): Set<T> => Set<T>(item1, item2, item3);

    // No `of(items: T...)` overload for 4+ elements: `SignatureSet` erases a varargs parameter's
    // element type the same way it erases a single one of that type, so `of(items: T...)` and
    // `of(item: T)` above both key to the emitted signature `of(E)` and collide in the method
    // table - confirmed by trying it (SURTR4001, "already declares a member with the signature
    // 'of(E)'"). Renaming one to dodge the collision isn't worth the asymmetry; a 4+ literal can
    // still reach a Set through `Set<T>(a, b, c, d, ...)`'s own constructor(items: T...), or
    // `[a, b, c, d].toSet()` (Sequence.surtr's IIterable<T> extension).


    public inline fun add(item: T): void
    {
        _dict[item] = true;
    }

    public inline fun remove(item: T): bool
    {
        return _dict.remove(item);
    }

    public inline fun clear(): void
    {
        _dict.clear();
    }

    public inline fun unionWith(other : ISet<T>): void
    {
        for (item in other)
            add(item);
    }

    public fun intersectWith(other : ISet<T>): void
    {
        let toRemove = dict<T, bool>();
        for (item in this)
        {
            if (!other.contains(item))
                toRemove[item] = true;
        }
        for (item in toRemove)
            remove(item[0]);
    }

    public fun exceptWith(other : ISet<T>): void
    {
        let toRemove = dict<T, bool>();
        for (item in other)
        {
            if (contains(item))
                toRemove[item] = true;
        }
        for (item in toRemove)
            remove(item[0]);
    }

    public fun symmetricExceptWith(other : ISet<T>): void
    {
        let selected = dict<T, bool>();
        for (item in other)
        {
            if (contains(item))
                selected[item] = false;
            else
                selected[item] = true;
        }
        for (item in selected)
        {
            if (item[1] == false)
                remove(item[0]);
            else
                add(item[0]);
        }
    }

    inline operator &(left: Set<T>, right: IReadOnlySet<T>): Set<T>
    {
        return intersect(left, right);
    }
    inline operator &(left: IReadOnlySet<T>, right: Set<T>): Set<T>
    {
        return intersect(left, right);
    }

    inline operator |(left: Set<T>, right: IReadOnlySet<T>): Set<T>
    {
        return union(left, right);
    }
    inline operator |(left: IReadOnlySet<T>, right: Set<T>): Set<T>
    {
        return union(left, right);
    }

    inline operator -(left: Set<T>, right: IReadOnlySet<T>): Set<T>
    {
        return except(left, right);
    }
    inline operator -(left: IReadOnlySet<T>, right: Set<T>): Set<T>
    {
        return except(left, right);
    }

    inline operator ^(left: Set<T>, right: IReadOnlySet<T>): Set<T>
    {
        return symmetricExcept(left, right);
    }
    inline operator ^(left: IReadOnlySet<T>, right: Set<T>): Set<T>
    {
        return symmetricExcept(left, right);
    }

    public static fun union(left: IReadOnlySet<T>, right: IReadOnlySet<T>): Set<T>
    {
        let result = Set<T>();
        for (item in left)
            result.add(item);
        for (item in right)
            result.add(item);
        return result;
    }

    public static fun intersect(left: IReadOnlySet<T>, right: IReadOnlySet<T>): Set<T>
    {
        let result = Set<T>();
        for (item in left)
        {
            if (right.contains(item))
                result.add(item);
        }
        for (item in right)
        {
            if (left.contains(item))
                result.add(item);
        }
        return result;
    }

    public static fun except(left: IReadOnlySet<T>, right: IReadOnlySet<T>): Set<T>
    {
        let result = Set<T>();
        for (item in left)
        {
            if (!right.contains(item))
                result.add(item);
        }
        return result;
    }

    public static fun symmetricExcept(left: IReadOnlySet<T>, right: IReadOnlySet<T>): Set<T>
    {
        let result = Set<T>();
        for (item in left)
        {
            if (!right.contains(item))
                result.add(item);
        }
        for (item in right)
        {
            if (!left.contains(item))
                result.add(item);
        }
        return result;
    }

    /// A read-only view over this set; stays live if the set changes underneath it.
    public inline fun asReadOnly(): IReadOnlyCollection<T> => ReadOnlyCollection<T>(this);
}

// Fase 8, §6.2/O3 + §6.3/P7: same reasoning as List<T>.toDisplayString() - a debug representation
// once T is known to have a real toString() to call.
public extension<T: object> ReadOnlySet<T>
{
    fun toDisplayString(self: ReadOnlySet<T>): string
    {
        var parts: string[] = array<string>(self.length);
        var i = 0;
        for (item in self)
        {
            parts[i] = item.toString();
            i += 1;
        }
        return "{" + string.join(", ", parts) + "}";
    }
}
