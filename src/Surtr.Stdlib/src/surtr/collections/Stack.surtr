import surtr.collections.Collection;

public interface IStack<T> default Stack<T> : ICollection<T>
{
    isEmpty: bool { get; }

    fun push(item: T): void;
    fun pop(): T;
    fun peek(): T;
}

public class Stack<T> : IStack<T>
{
    private let _items: T[];

    public constructor()
    {
        this._items = [];
    }

    // §5.x: the collection-builder form — `Stack<int>[1, 2, 3]` fills through this $fill$ method.
    public constructor() : this()
    {
    }
    each (item: T)
    {
        push(item);
    }

    public inline length: int => _items.length;
    public inline isReadOnly: bool => false;
    public inline isEmpty: bool => _items.length == 0;

    public inline top: T => _items[_items.length - 1];

    public fun push(item: T): void => _items.push(item);

    public fun pop(): T
    {
        if (isEmpty)
            throw InvalidOperationException("Stack is empty.");
        return _items.pop();
    }

    public fun peek(): T
    {
        if (isEmpty)
            throw InvalidOperationException("Stack is empty.");

        return _items.get(_items.length - 1);
    }

    public inline fun add(item: T): void => push(item);
    public inline fun remove(item: T): bool { throw InvalidOperationException("Stack does not support removing arbitrary items."); }
    public inline fun clear(): void => _items.clear();

    public fun contains(item: T): bool => _items.contains(item);

    public fun copyTo(array: T[], arrayIndex: int): void
    {
        for (i in 0.._items.length - 1)
            array[arrayIndex + i] = _items[i];
    }

    public inline fun iterate(): IIterator<T> => Iterator<T>(_items, _items.length);

    // Iterates top-to-bottom, i.e. in pop() order: `_index` starts one past the top and counts
    // down to 0. Walking bottom-to-top (insertion order) here used to make `for (x in stack)`
    // silently disagree with what pop() would hand back, surprising anyone iterating a stack for
    // its stack semantics (Plan-Revision-Stdlib.md D3).
    private sealed class Iterator<T> : IIterator<T>
    {
        private let _items: T[];
        private let _length: int;
        private var _index: int;

        public constructor(items: T[], length: int)
        {
            _items = items;
            _length = length;
            _index = length;
        }

        public current: T
        {
            get
            {
                if (_index < 0 || _index >= _length) throw IndexOutOfRangeException("Iterator is out of bounds");
                return _items[_index];
            }
        }

        // Nothing held that outlives this cursor, so the contract slot is filled and empty.
        public fun dispose(): void { }

        public fun moveNext(): bool
        {
            if (_index <= 0) return false;
            _index--;
            return true;
        }
    }
}

// Fase 8, §6.2/O3 + §6.3/P7: same reasoning as List<T>.toDisplayString(). Order matches iterate()'s
// own pop order (top-to-bottom, D3), not insertion order.
public extension<T: object> Stack<T>
{
    fun toDisplayString(self: Stack<T>): string
    {
        var parts: string[] = array<string>(self.length);
        var i = 0;
        for (item in self)
        {
            parts[i] = item.toString();
            i += 1;
        }
        return "[" + string.join(", ", parts) + "]";
    }
}
