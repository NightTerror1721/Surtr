import surtr.math.Math;

// Fase 8, §6.3/P5: two variants, matching two different hosts' conventions. `Color` (four floats,
// [0, 1] per channel) is what a shader/GPU-facing API wants and what Unity's own `Color` uses.
// `Color32` (one packed 0xAARRGGBB int) is the compact, cache-friendly form a vertex buffer or a
// serialized asset wants, and what a byte-oriented protocol/save format wants. Both convert to the
// other losslessly in the float->byte direction only, since encoding to a byte quantizes.
public value class Color
{
    public let r: float;
    public let g: float;
    public let b: float;
    public let a: float;

    public constructor(r: float, g: float, b: float, a: float = 1.0)
    {
        this.r = r;
        this.g = g;
        this.b = b;
        this.a = a;
    }

    public static black: Color => Color(0.0, 0.0, 0.0, 1.0);
    public static white: Color => Color(1.0, 1.0, 1.0, 1.0);
    public static red: Color => Color(1.0, 0.0, 0.0, 1.0);
    public static green: Color => Color(0.0, 1.0, 0.0, 1.0);
    public static blue: Color => Color(0.0, 0.0, 1.0, 1.0);
    public static yellow: Color => Color(1.0, 1.0, 0.0, 1.0);
    public static cyan: Color => Color(0.0, 1.0, 1.0, 1.0);
    public static magenta: Color => Color(1.0, 0.0, 1.0, 1.0);
    public static clear: Color => Color(0.0, 0.0, 0.0, 0.0);

    @Pure
    public fun withAlpha(newAlpha: float): Color => Color(r, g, b, newAlpha);

    /// Linear interpolation per channel, `t` clamped to `[0, 1]`.
    public static fun lerp(a: Color, b: Color, t: float): Color
    {
        let ct = clamp01(t);
        return Color(
            a.r + (b.r - a.r) * ct,
            a.g + (b.g - a.g) * ct,
            a.b + (b.b - a.b) * ct,
            a.a + (b.a - a.a) * ct);
    }

    /// Quantizes each channel to `[0, 255]`, rounding rather than truncating.
    public fun toColor32(): Color32
    {
        return Color32.fromChannels(
            channelToByte(r), channelToByte(g), channelToByte(b), channelToByte(a));
    }

    @Pure
    public override fun toString(): string => "($r, $g, $b, $a)";

    @Pure
    operator+(a: Color, b: Color): Color { return Color(a.r + b.r, a.g + b.g, a.b + b.b, a.a + b.a); }
    @Pure
    operator*(a: Color, scalar: float): Color { return Color(a.r * scalar, a.g * scalar, a.b * scalar, a.a * scalar); }

    @Pure
    inline operator==(a: Color, b: Color): bool { return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a; }

    public inline fun equals(other: Color): bool => this == other;
}

private fun channelToByte(channel: float): int
{
    let clamped = clamp01(channel);
    return round(clamped * 255.0).toInt();
}

/// A color packed as one 32-bit `0xAARRGGBB` int - four bytes, no per-channel float math.
public value class Color32
{
    private let _packed: int;

    /// `packed` is `0xAARRGGBB` - alpha in the high byte, blue in the low byte.
    public constructor(packed: int)
    {
        this._packed = packed;
    }

    public static inline fun fromChannels(r: int, g: int, b: int, a: int = 255): Color32
        => Color32(((a & 0xFF) << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF));

    public static black: Color32 => Color32.fromChannels(0, 0, 0, 255);
    public static white: Color32 => Color32.fromChannels(255, 255, 255, 255);
    public static clear: Color32 => Color32.fromChannels(0, 0, 0, 0);

    @Pure
    public inline r: int { get { return (_packed >> 16) & 0xFF; } }
    @Pure
    public inline g: int { get { return (_packed >> 8) & 0xFF; } }
    @Pure
    public inline b: int { get { return _packed & 0xFF; } }
    @Pure
    public inline a: int { get { return (_packed >> 24) & 0xFF; } }

    /// The raw `0xAARRGGBB` packed value.
    public inline raw: int => _packed;

    @Pure
    public fun toColor(): Color => Color(r.toFloat() / 255.0, g.toFloat() / 255.0, b.toFloat() / 255.0, a.toFloat() / 255.0);

    @Pure
    public override fun toString(): string => "($r, $g, $b, $a)";

    @Pure
    inline operator==(x: Color32, y: Color32): bool { return x._packed == y._packed; }

    public inline fun equals(other: Color32): bool => _packed == other._packed;
}
