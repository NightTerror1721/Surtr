<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Surtr.Interop.SourceGenerator</RootNamespace>
    <AssemblyName>Surtr.Interop.SourceGenerator</AssemblyName>

    <!-- A Roslyn analyzer must target netstandard2.0 and declare itself as such, so the compiler
         (and Unity's Roslyn) can load it. The generated code itself references Surtr.Interop and
         Surtr.Core in the consumer's compilation. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- No XML docs: a generator is not consumed as a library, so CS1591 is noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- The analyzer-release tracking the Roslyn analyzers validate: every rule in SurtrDiagnostics
       is listed in Unshipped, so RS2008 passes without a NoWarn suppression. -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
