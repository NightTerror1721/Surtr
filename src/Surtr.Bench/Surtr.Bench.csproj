<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- A standalone benchmark harness, run by hand with `dotnet run` on this project. It is
         deliberately not part of the test suite: timings are not deterministic and must not gate
         the 1753 tests. It compares Surtr against MoonSharp and LuaJIT (both Lua) on the same
         workloads, and needs the compiler to turn embedded Surtr source into a module, which is
         why it references Surtr.Compiler rather than Surtr.Core alone. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Surtr.Bench</RootNamespace>
    <AssemblyName>surtrbench</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- A command-line program is never consumed as a library, so CS1591 would only be noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Only the native-function registration site takes &HostAdd, and that is all. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Surtr.Core\Surtr.Core.csproj" />
    <ProjectReference Include="..\Surtr.Compiler\Surtr.Compiler.csproj" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="luajit.native" Version="2.1.1785598229" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- luajit.native is a C++-style package: its targets glob bin\$(Platform)\*.dll and $(Platform)
       is AnyCPU here, so the glob matches nothing and lua51.dll would never reach the output. Copy
       the x64 build explicitly. The native driver is x64-only by construction; a bench run on any
       other architecture will fail to load it, which is the honest failure to get. -->
  <ItemGroup>
    <None Include="$(Pkgluajit_native)\build\native\bin\x64\lua51.dll" Link="lua51.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
